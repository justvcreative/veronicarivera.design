---
/** IconButton: 44px square, border-strong edge, radius-md, and an aria-label that names the action. */
import Icon from './Icon.astro';
import type { HTMLAttributes } from 'astro/types';
type Props = HTMLAttributes<'button'> & { icon: Parameters<typeof Icon>[0]['name']; label: string; round?: boolean };
const { icon, label, round = false, class: className, ...rest } = Astro.props;
---
<button type="button" class:list={['vr-iconbtn', round && 'vr-iconbtn--round', className]} aria-label={label} {...rest}>
  <Icon name={icon} />
</button>
