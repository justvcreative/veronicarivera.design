---
import Button from '../Button.astro';
import Icon from '../Icon.astro';
interface Props { href: string; teaser: string }
const { href, teaser } = Astro.props;
---
<nav class="cs-next" aria-label="More case studies">
  <div class="cs-next__inner">
    <div class="cs-next__text">
      <p class="cs-next__label">Next case study</p>
      <p class="cs-next__teaser">{teaser}</p>
    </div>
    <div class="cs-next__links">
      <Button href={href}>Read case study <Icon name="arrow-right" size={20} /></Button>
      <a class="vr-link cs-next__back" href="/work/"><Icon name="arrow-left" size={18} />Back to all work</a>
    </div>
  </div>
</nav>
