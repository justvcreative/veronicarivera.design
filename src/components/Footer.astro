---
/** Footer: a navy band in both themes, with the ivory logo, tagline, icon links and copyright. */
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SITE, SOCIAL } from '../data/site';
const social = SOCIAL.filter((s) => s.href);
const year = new Date().getFullYear();
const [t1, t2] = SITE.tagline.split(/(?<=\.)\s+/);
---
<footer class="footer">
  <div class="footer__inner">
    <div class="footer__id">
      <a class="footer__brand" href="/">
        <Logo size={48} class="footer__logo" />
        <span class="footer__name">{SITE.name}</span>
      </a>
      <p class="footer__tagline"><span>{t1}</span> <span>{t2}</span></p>
      {social.length > 0 && (
        <ul class="footer__social" aria-label="Find me elsewhere">
          {social.map((s) => {
            const external = !s.href.startsWith('mailto:');
            return (
              <li>
                <a class="footer__icon" href={s.href} aria-label={s.label + (external ? ' (opens in a new tab)' : '')}
                  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                  <Icon name={s.icon} />
                </a>
              </li>
            );
          })}
        </ul>
      )}
    </div>
    <p class="footer__copy">© {year} {SITE.name}</p>
  </div>
</footer>

<style>
  .footer { background: var(--navy); color: var(--ivory); }
  .footer__inner {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-5) var(--space-6);
    padding: var(--space-7) var(--space-6);
  }
  .footer__id { display: flex; flex-direction: column; gap: var(--space-2); }
  .footer__brand { display: inline-flex; align-items: center; gap: var(--space-3); text-decoration: none; color: var(--ivory); border-radius: var(--radius-sm); align-self: flex-start; }
  .footer__name { font-size: 1.5rem; font-weight: 500; line-height: 1.2; }
  .footer__tagline {
    padding-left: calc(48px + var(--space-3));
    font-family: var(--font-mono); font-size: 0.875rem; line-height: 1.5; letter-spacing: 0.1em; text-transform: uppercase;
  }
  .footer__social { list-style: none; margin: 0; padding: 0 0 0 calc(48px + var(--space-3) - 10px); display: flex; flex-wrap: wrap; }
  .footer__icon {
    display: inline-flex; align-items: center; justify-content: center; width: var(--target-min); height: var(--target-min);
    border-radius: var(--radius-md); color: var(--apricot); transition: color 300ms ease-in-out;
  }
  .footer__icon:hover { color: var(--ivory); }
  .footer__copy { font-family: var(--font-mono); font-size: 0.875rem; line-height: 1.5; letter-spacing: 0.04em; }
  .footer a:focus-visible { outline: 2px solid transparent; box-shadow: 0 0 0 2px var(--navy), 0 0 0 4px var(--apricot); }

  @media (max-width: 719.98px) {
    .footer__inner { flex-direction: column; align-items: flex-start; padding: var(--space-7) var(--space-4); gap: var(--space-4); }
    .footer__brand { flex-direction: column; align-items: flex-start; gap: var(--space-3); }
    .footer__brand :global(.footer__logo) { width: 52px; height: 52px; }
    .footer__name { font-size: 20px; }
    .footer__tagline { padding-left: 0; line-height: 1.3; }
    .footer__tagline span { display: block; }
    .footer__social { padding-left: 0; margin-left: -10px; }
  }
</style>
